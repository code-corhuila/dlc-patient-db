# Copy to deploy/env/qa.env (ignored by Git). QA: back up before every update; never remove the volume (Annex J.5.4).
# dlc-infra-postgres runs this environment as Compose project dlc-qa (Annex J.5.1);
# its engine container is reachable on the platform network by that unique name.
COMPOSE_PROJECT_NAME=patients-db-qa
PG_ENVIRONMENT=qa
PG_HOST=dlc-qa-dlc-postgres-1
PG_PORT=5432
PG_DATABASE=di_lucca
PG_NETWORK=platform
PG_MIGRATOR_PASSWORD_FILE=replace-with-absolute-path-to-the-qa-migrator-secret
