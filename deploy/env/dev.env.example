# Copy to deploy/env/dev.env (ignored by Git). Development: synthetic seeds apply in this context.
# dlc-infra-postgres runs this environment as Compose project dlc-dev (Annex J.5.1);
# its engine container is reachable on the platform network by that unique name.
COMPOSE_PROJECT_NAME=patients-db-dev
PG_ENVIRONMENT=dev
PG_HOST=dlc-dev-dlc-postgres-1
PG_PORT=5432
PG_DATABASE=di_lucca
PG_NETWORK=platform
PG_MIGRATOR_PASSWORD_FILE=replace-with-absolute-path-to-the-dev-migrator-secret
