# Copy to deploy/env/main.env (ignored by Git). Production: back up and verify restore before every update (Annex J.5.4).
# dlc-infra-postgres runs this environment as Compose project dlc-main (Annex J.5.1);
# its engine container is reachable on the platform network by that unique name.
COMPOSE_PROJECT_NAME=patients-db-main
PG_ENVIRONMENT=main
PG_HOST=dlc-main-dlc-postgres-1
PG_PORT=5432
PG_DATABASE=di_lucca
PG_NETWORK=platform
PG_MIGRATOR_PASSWORD_FILE=replace-with-absolute-path-to-the-main-migrator-secret
